# Copia este archivo a .env para pruebas locales.
# En Railway/Render estas variables se configuran en el panel del servicio,
# no en un archivo.

# La crea automáticamente Railway/Render al agregar un addon de Postgres.
# Si se deja vacío, usa un SQLite local (server.db) para pruebas.
DATABASE_URL=

# Usuario/clave para entrar al panel (Basic Auth).
ADMIN_USER=admin
ADMIN_PASSWORD=cambia-esto

# Debe coincidir con SYNC_API_KEY configurado en el mini PC.
INGEST_API_KEY=genera-una-clave-larga-aleatoria

# Días que se conservan los conteos antes de purgarse automáticamente.
RETENTION_DAYS=45
